{
  "buildCommand": "npx expo export --platform web && cp public/privacy.html dist/privacy.html",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/privacy.html", "destination": "/privacy.html" },
    { "source": "/((?!privacy).*)", "destination": "/index.html" }
  ]
}
